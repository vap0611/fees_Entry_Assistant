# Fees Entry Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for natural language fee processing)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server & Session Security Configuration
PORT=5001
FLASK_DEBUG=false
# Optional persistent session signing key (auto-generated in data/.flask_secret if omitted)
FLASK_SECRET_KEY=
# Set to true when terminating TLS/HTTPS directly or via reverse proxy
FORCE_HTTPS=false
